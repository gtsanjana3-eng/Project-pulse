# Required. Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
PP_SECRET=
PP_ENV=development
PP_DB_PATH=projectpulse.db
# Comma-separated explicit origins (no "*")
PP_CORS_ORIGINS=http://localhost:5173
PP_MAX_PROJECTS=25
PP_AUDITS_PER_HOUR=10
PP_LOGINS_PER_15MIN=10
# Enables browser + accessibility checks. Path to axe-core's axe.min.js (npm i axe-core -> node_modules/axe-core/axe.min.js)
PP_AXE_PATH=
# Set to 1 only inside containers that run as root
PP_BROWSER_NO_SANDBOX=0
